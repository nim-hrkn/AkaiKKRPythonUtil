# python
__pycache__/
*.pyc
build/
dist/
*.egg-info/
.pytest_cache/
.eggs/

# outputs of the regression test sets (tests/testrun/<set>/<material>/, result*.json, figures);
# only the scripts, reference/*.json and the patch are versioned
tests/testrun/*/*/
!tests/testrun/*/reference/
tests/testrun/*/result*.json
tests/testrun/*/*.log
tests/testrun/*/*.png

# outputs of the pytest / GAES runs and of the examples
tests/gaes/RUN/
tests/gaes/RUN_Hf_stopped/
examples/gaes/*_ewidth/
examples/gaes/*-valence/
examples/gaes/*-core/
examples/gaes/*.png
examples/gaes/*.log
scripts/gaes_survey/RUN*/
